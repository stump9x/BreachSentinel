# =============================================================================
# BreachSentinel — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to version control.
# =============================================================================

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Set True for local runs without Postgres (not for production)
USE_SQLITE=False

# --- PostgreSQL ---
POSTGRES_DB=breachsentinel
POSTGRES_USER=breachsentinel
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
# VPS: reuse healthy Gunicorn DB connections (local default can stay 0)
DJANGO_DB_CONN_MAX_AGE=0

# --- Redis / Celery ---
REDIS_PASSWORD=breachsentinel-redis
REDIS_URL=redis://:breachsentinel-redis@redis:6379/0
CELERY_BROKER_URL=redis://:breachsentinel-redis@redis:6379/0
CELERY_RESULT_BACKEND=redis://:breachsentinel-redis@redis:6379/1
# Auto-expire Celery results in Redis DB1 (seconds)
CELERY_RESULT_EXPIRES=3600
# Shared-VPS defaults are selected automatically by deploy/vps/optimize_vps.sh
GUNICORN_WORKERS=2
CELERY_WORKER_CONCURRENCY=2
CELERY_MAX_TASKS_PER_CHILD=100
CELERY_MAX_MEMORY_PER_CHILD_KB=450000

# --- Auth / crypto ---
AUTH_TOKEN_TTL_HOURS=12
# Optional: openssl rand -hex 32
CREDENTIAL_PEPPER=
# Optional Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Service URLs (internal Docker network) ---
OSINT_SERVICE_URL=http://osint:8080
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- AI Providers ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307
# Preferred free-tier LLM for briefings + forum title enrich (not Gemini).
GROQ_API_KEY=
# Extra Groq keys (comma/newline) — exclusive slice vs NewsCrawler (sync_groq_keys script).
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SEC=12
GROQ_KEY_COOLDOWN_SEC=120
GROQ_MAX_KEY_ATTEMPTS=2
GROQ_MIN_INTERVAL_SEC=1.25
GROQ_STOP_ON_FIRST_429=true
GROQ_CIRCUIT_TTL_SEC=180
GROQ_FAIL_TRIP_THRESHOLD=1
# Isolate this app's Groq pool from NewsCrawler (do not share the same keys).
GROQ_POOL_NAMESPACE=breachsentinel
TITLE_TRANSLATE_GROQ=true
TITLE_TRANSLATE_PREFER_GROQ=true
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_NER_MODEL=dslim/bert-base-NER
HUGGINGFACE_SUMMARIZE_MODEL=google/flan-t5-base

# Wire title → Vietnamese
# 1) Google Translate  2) optional Ollama polish (off by default; validated when on)
TITLE_TRANSLATE_ENABLED=true
TITLE_TRANSLATE_AI_REFINE=false
# false = ingest first, then translate immediately in Celery without blocking RSS scans
TITLE_TRANSLATE_INLINE_GOOGLE=false
GOOGLE_TRANSLATE_TIMEOUT_SEC=20
# After Google 429/captcha, skip direct Google and use Tor/Ollama
GOOGLE_TRANSLATE_CIRCUIT_SEC=300
GOOGLE_TRANSLATE_PACING_SEC=0.8
# When datacenter IP gets Google captcha/429, retry via Tor SOCKS (needs TOR_ENABLED).
GOOGLE_TRANSLATE_TOR_FALLBACK=true
# Prefer Ollama for CJK titles; compare Ollama vs Google for other non-English.
TITLE_TRANSLATE_CJK_PREFER_OLLAMA=true
TITLE_TRANSLATE_NON_EN_OLLAMA_COMPARE=true
TITLE_TRANSLATE_OLLAMA_FALLBACK=true
# Last-resort HTTP fallback when Google + Ollama are unavailable
TITLE_TRANSLATE_MYMEMORY_FALLBACK=true
OLLAMA_ENABLED=true
# VPS compose: http://ollama:11434  |  host install: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_TRANSLATE_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SEC=120
OLLAMA_NUM_PREDICT=128
OLLAMA_NUM_CTX=1024
OLLAMA_KEEP_ALIVE=15m
# Cap Ollama container RAM on shared VPS (docker-compose.vps.yml)
OLLAMA_MEM_LIMIT=4g
# Leave empty to use built-in hành chính / CTI refine prompt ({title}, {draft}).
TITLE_TRANSLATE_REFINE_PROMPT=
TITLE_TRANSLATE_FALLBACK_PROMPT=
TITLE_TRANSLATE_PROMPT=
# Wire description → Vietnamese. Google uses source-language auto-detection;
# Ollama is called only if Google fails. Hash caching prevents repeat requests.
SUMMARY_TRANSLATE_ENABLED=true
SUMMARY_TRANSLATE_MAX_CHARS=1200
SUMMARY_TRANSLATE_MAX_ATTEMPTS=3
SUMMARY_TRANSLATE_OLLAMA_FALLBACK=true
SUMMARY_TRANSLATE_OLLAMA_NUM_PREDICT=360
SUMMARY_TRANSLATE_FALLBACK_PROMPT=

# --- Breach Intelligence APIs ---
HUDSON_ROCK_API_KEY=
PROXYNOVA_API_KEY=
BREACHDIRECTORY_API_KEY=

# --- MISP ---
MISP_URL=
MISP_API_KEY=
MISP_VERIFY_SSL=True

# --- TheHive ---
THEHIVE_URL=
THEHIVE_API_KEY=

# --- OSINT / Social ---
X_BEARER_TOKEN=
TELEGRAM_BOT_TOKEN=
# SearxNG metasearch (Docker service: http://searxng:8080 — host UI :8888)
FEED_DELETE_AFTER_FAILURES=3
WIRE_MAX_AGE_DAYS=7
# 0 = keep Vietnam stories forever on The Wire / ingest / purge
WIRE_VIETNAM_MAX_AGE_DAYS=0
# Only Vietnam ≤ this many days stay pinned at the top of The Wire
WIRE_VIETNAM_PIN_DAYS=7
# Daily Celery beat purge of Wire rows past the windows above (safe; never wipes recent non-VN)
WIRE_HOUSEKEEPING_ENABLED=true
WIRE_IMPACT_PRIORITY=50
WIRE_WORDPRESS_BACKFILL_INTERVAL_MINUTES=360
WIRE_WORDPRESS_SOURCES_PER_SWEEP=3
RSS_PROCESSING_VERSION=4
TOR_ENABLED=true
TOR_SOCKS_PROXY=socks5h://tor:9150
SEARXNG_URL=http://searxng:8080
# Open-web only — do not include github (use GitHub Scanner). ahmia = onion index (clearnet).
SEARXNG_ENGINES=duckduckgo,brave,bing,gitlab,bitbucket,npm,stackoverflow,qwant,ahmia
SEARXNG_SECRET=change-me-searxng-secret-key-for-local-dev-only
# Open-web leak enrichment (Jina) — Wire/GitHub Scanner unchanged
WEB_READER_ENABLED=true
WEB_READER_BACKEND=jina
SEARX_LEAK_ENRICH=true
SEARX_QUERY_PACKS=true
# Prefer fresher open-web hits: day|week|month|year (empty = no filter)
SEARX_TIME_RANGE=month
# Exa semantic search — high-signal fallback when keyed (prefer Searx/X/Reddit first)
# Dashboard: https://dashboard.exa.ai → API Key
EXA_API_KEY=
# auto|fast|deep — keep auto; deep burns credits heavily
EXA_SEARCH_TYPE=auto
# NL queries per OSINT/leak keyword (1 = frugal)
EXA_QUERY_COUNT=1
# Official recipe: contents.highlights (leak guides by keyword; wire uses true)
EXA_HIGHLIGHTS=true
EXA_INCLUDE_TEXT=false
EXA_REQUIRE_PHRASE=true
# Optional: EXA_MAX_AGE_HOURS=24  (omit = Exa default cache/livecrawl)
EXA_RECENCY_DAYS=90
# Optional: EXA_CATEGORY=news
# Optional allowlist (comma hosts). Empty = whole web minus excludes.
# EXA_INCLUDE_DOMAINS=
EXA_EXCLUDE_DOMAINS=github.com,www.github.com,gist.github.com
# OSINT ad-hoc: fallback = Exa only if other channels kept < MIN_HITS (or use_exa=true)
EXA_OSINT_MODE=fallback
EXA_OSINT_MIN_HITS=5
# Watch Rule leak sweeps: same gating
EXA_LEAK_MODE=fallback
EXA_LEAK_MIN_HITS=5
# Exa → The Wire (Threat feed). Requires EXA_API_KEY. Beat every 60m.
EXA_WIRE_ENABLED=true
EXA_WIRE_MAX_AGE_DAYS=14
EXA_WIRE_LIMIT=8
EXA_WIRE_LIMIT_PER_DOMAIN=2
EXA_WIRE_QUERY_COUNT=2
# Optional custom NL queries, pipe-separated (empty = built-in CTI pack)
# EXA_WIRE_QUERIES=Latest ransomware attacks|Latest data breaches Vietnam

# X/Twitter cookie search — SECONDARY account only (never commit real cookies)
# How to get: browser Cookie-Editor on https://x.com → copy auth_token and ct0
X_TWITTER_ENABLED=true
X_AUTH_TOKEN=
X_CT0=
# Optional — only if GraphQL returns 404 after X rotates endpoints
# X_SEARCH_QUERY_ID=R0u1RWRf748KzyGBXvOYRA
# X_TWEET_QUERY_ID=Xl5pC_lBk_gcO2ItU39DQw
# X CTI accounts → The Wire (empty X_WIRE_ACCOUNTS = built-in pack)
X_WIRE_ENABLED=true
X_WIRE_MAX_AGE_DAYS=7
X_WIRE_LIMIT_PER_ACCOUNT=8
# X_WIRE_ACCOUNTS=IBreaches,darkwebsonar,Beralock,H4ckmanac,DailyDarkWeb,FalconFeedsio,Cyber_Citadel,VECERTRadar,6xvdpx,GroupIB_TI
X_WIRE_PAUSE_MS=400

# Reddit — SECONDARY account. Search needs full Cookie header (not just one value).
# Cookie-Editor on reddit.com → Export → Header String → paste after REDDIT_COOKIE=
REDDIT_SEARCH_ENABLED=true
REDDIT_ENRICH_ENABLED=true
# Prefer recall then local phrase filter (new+month often returns 0 for VN phrases)
REDDIT_SEARCH_SORT=relevance
REDDIT_SEARCH_TIME=all
REDDIT_COOKIE=

# Paste/raw specialized fetch
PASTE_ENRICH_ENABLED=true
PASTE_EXTRA_HOSTS=
# Fine-grained read-only PAT; never commit a real token.
GITHUB_TOKEN=
BRUTEFORCEAI_INTERNAL_TOKEN=replace-with-a-long-random-lab-only-token
BRUTEFORCEAI_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal,app.test
BRUTEFORCEAI_ALLOW_PUBLIC_TARGETS=false
BRUTEFORCEAI_MAX_CREDENTIALS=20
BRUTEFORCEAI_MIN_DELAY_SECONDS=2
BRUTEFORCEAI_JOB_TIMEOUT_SECONDS=900
BRUTEFORCEAI_REF=main
# BruteForceAI runs analyze/stage1 before attack. Configure one provider.
BRUTEFORCEAI_LLM_PROVIDER=groq
BRUTEFORCEAI_LLM_MODEL=openai/gpt-oss-120b
BRUTEFORCEAI_LLM_API_KEY=
BRUTEFORCEAI_OLLAMA_URL=
BRUTEFORCEAI_ANALYZE_TIMEOUT_SECONDS=600
BRUTEFORCEAI_AUTO_SELECTOR_FALLBACK=true
# Time allowed for SPA redirects, auth storage, and success/failure UI to settle.
BRUTEFORCEAI_SPA_SETTLE_SECONDS=8
# headless is recommended on servers; headed uses Chromium under Xvfb.
BRUTEFORCEAI_BROWSER_MODE=headless
GITHUB_MAX_FILE_BYTES=512000
GITHUB_CONTENT_FETCH_LIMIT=120
GITHUB_STREAM_BATCH_SIZE=5
GITHUB_SCAN_STALE_MINUTES=20
GITHUB_SCAN_MAX_RESULTS=1500

# Zone-H / defacement → The Wire (latest archive pages)
# Default: haxor.id (accessible mirror, no captcha from cloud IPs).
# Official zone-h.org needs cookies after captcha (BAUZACE7/Zone-H style bypass):
#   ZONEH_PROVIDER=zoneh
#   ZONEH_PHPSESSID=...
#   ZONEH_ZHE=...
ZONEH_ENABLED=true
ZONEH_PROVIDER=haxor
ZONEH_PAGES=2
ZONEH_INCLUDE_SPECIAL=true
# ZONEH_PHPSESSID=
# ZONEH_ZHE=

# Forum / claim news → The Wire (clearnet secondary only — no forum cookies/VNC).
FORUM_AI_ENRICH=true

# --- Auth (OIDC / LDAP — Phase later) ---
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_OP_AUTHORIZATION_ENDPOINT=
OIDC_OP_TOKEN_ENDPOINT=
OIDC_OP_USER_ENDPOINT=
OIDC_OP_JWKS_ENDPOINT=
LDAP_SERVER_URI=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# --- Go OSINT Microservice ---
OSINT_LISTEN_ADDR=:8080
OSINT_MAX_CONCURRENCY=50
OSINT_HTTP_TIMEOUT_SEC=8
OSINT_SITES_PATH=/app/data/sites.json
OSINT_USER_AGENT=BreachSentinel-OSINT/0.4 (+local; research)
